# Virtual environments
.venv/
venv/
ENV/
env/

# Environment / secrets
# Service-account keys must never be committed. On Cloud Run the service
# authenticates as its own identity, so no key file should exist at all —
# if one appears here, something is wrong with the auth setup.
.env
.env.*
!.env.example
*-key.json
*-credentials.json
service-account*.json
application_default_credentials.json

